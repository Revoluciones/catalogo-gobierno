{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Revoluciones/catalogo-gobierno/esquema/formato.schema.json",
  "title": "Formato oficial",
  "description": "Un formato oficial en PDF y dónde va cada dato, para llenarlo en el navegador. Un paso lo usa con form: <id>.",
  "type": "object",
  "required": ["id", "title", "jurisdiction", "authority", "source", "file", "sha256", "fields", "draw"],
  "additionalProperties": false,
  "properties": {
    "id": {"type": "string", "pattern": "^[a-z0-9-]+$"},
    "title": {"type": "string", "description": "El nombre del formato, como lo verá la persona."},
    "jurisdiction": {"type": "string"},
    "authority": {"type": "string", "description": "Quién publica el formato."},
    "source": {
      "type": "object", "required": ["title", "url", "retrieved"], "additionalProperties": false,
      "properties": {
        "title": {"type": "string"},
        "url": {"type": "string", "description": "Dónde se descarga el formato oficial."},
        "retrieved": {"type": "string", "description": "Fecha en que se bajó la copia, AAAA-MM-DD."}
      }
    },
    "file": {"type": "string", "description": "La copia del PDF oficial, sin cambios, junto a este archivo."},
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "sign": {"type": "string", "description": "Qué hacer con el PDF ya lleno: quién firma y cómo."},
    "fields": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "required": ["key", "label"], "additionalProperties": false,
        "properties": {
          "key": {"type": "string", "pattern": "^[a-z0-9_]+$"},
          "label": {"type": "string"},
          "group": {"type": "string", "description": "Título del grupo de campos en el formulario."},
          "help": {"type": "string"},
          "type": {"enum": ["text", "date", "choice", "tel"]},
          "required": {"type": "boolean"},
          "default": {"type": "string", "description": "Valor inicial; today pone la fecha de hoy."},
          "options": {
            "type": "array",
            "items": {"type": "object", "required": ["value", "label"], "additionalProperties": false,
                      "properties": {"value": {"type": "string"}, "label": {"type": "string"}}}
          }
        }
      }
    },
    "draw": {
      "type": "array", "minItems": 1,
      "description": "Dónde escribe cada dato, en puntos PDF desde la esquina superior izquierda; y es la línea base. {campo}, y para fechas {campo.dia}, {campo.mes} y {campo.año}.",
      "items": {
        "type": "object", "required": ["text", "x", "y"], "additionalProperties": false,
        "properties": {
          "text": {"type": "string"},
          "when": {"type": "object", "additionalProperties": {"type": "string"}, "description": "Solo si el campo tiene ese valor (para marcar una opción)."},
          "page": {"type": "integer", "minimum": 0},
          "x": {"type": "number"}, "y": {"type": "number"},
          "size": {"type": "number"},
          "align": {"enum": ["left", "center"]},
          "width": {"type": "number", "description": "Ancho máximo; si el texto no cabe, se achica la letra."}
        }
      }
    }
  }
}
